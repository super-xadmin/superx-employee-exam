{
  "name": "employee-assessment-hub",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16" },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/worker.js && node --check public/app.js && npm test",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "node scripts/deploy.mjs --prepare-only && wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/deploy.mjs",
    "deploy:worker-only": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "devDependencies": { "wrangler": "4.168.0" }
}
